# Installed development dependencies (restored with `npm ci`)
node_modules/

# Local verification artefacts: created by the test/audit harnesses at run time.
.tmp-browser/
.tmp-test/
.tmp-capsule/
.local/
__pycache__/
*.pyc

# Metadata fixtures are generated by the test run (Pillow/lcms output differs
# between builds), so they are never committed: they are written to
# .tmp-browser/fixtures and served from there.
test/fixtures/metadata/
test/fixtures/exif-test.jpg

# Editor and OS noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Local settings exports a user may drop next to the checkout
save-image-as-type-settings.json

# Release archives are rebuildable from source and are attached to GitHub
# Releases instead of being committed; the installable userscript itself IS
# committed (see docs/release-process.md).
release/*.zip
